.venv/
__pycache__/
*.py[cod]
# modello MediaPipe: si riscarica da Google, 8 MB
camera/modelli/
camera/foto/
*.jpg
*.png
# ACT: dataset e foto di prova (centinaia di MB)
act/dati/
act/outputs/
# Kaggle: dataset caricati e modelli scaricati (GB), per ogni run (kaggle, kaggle_50...)
act/kaggle*/dataset/*.zip
act/kaggle*/output/
# log del policy server e del robot client (inferenza asincrona)
act/logs/
# Kaggle sim: codice.zip si rigenera da act/kaggle_sim/codice/
act/kaggle*/pacchetto/*.zip
# texture della scena MuJoCo: piccole e servono alla simulazione
!act/kaggle_sim/codice/robotica/scenes/**/*.png
# output di Kaggle anche nelle sottocartelle (kaggle_sim/gen/output, kaggle_sim/run_c/output...)
act/kaggle*/**/output/
